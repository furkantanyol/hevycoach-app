{
  "name": "server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "validate": "pnpm typecheck && pnpm test",
    "tunnel": "sh -c 'set -a; . ./.env; set +a; cloudflared tunnel run --token \"$CLOUDFLARE_TUNNEL_TOKEN\"'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "hevy-sdk": "1.0.0",
    "expo-server-sdk": "^7.2.0",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
