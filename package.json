{
  "name": "hevycoach-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "lint": "expo lint src server",
    "typecheck": "tsc --noEmit",
    "validate": "pnpm lint && pnpm typecheck && pnpm --filter server validate",
    "ios:device": "expo run:ios --device",
    "ios:build": "eas build --profile development --platform ios --local --output ./build/hevycoach-dev.ipa",
    "ios:install": "xcrun devicectl device install app --device \"$DEVICE_ID\" build/hevycoach-dev.ipa"
  },
  "dependencies": {
    "@assistant-ui/react-native": "^0.1.40",
    "@expo/ui": "~57.0.17",
    "@ronradtke/react-native-markdown-display": "^9.0.3",
    "assistant-cloud": "^0.1.43",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-glass-effect": "~57.0.2",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-pager-view": "8.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  }
}
