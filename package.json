{
  "name": "hevycoach-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@furkantanyol/hevy-client": "1.0.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@sentry/cli": "2.58.4",
    "@types/jest": "~29.5.14",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "pnpm lint && pnpm lint:functions && pnpm typecheck && pnpm typecheck:functions && pnpm test && pnpm test:functions && pnpm export:web",
    "ios:device": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios --device",
    "ios:build": "SENTRY_DISABLE_AUTO_UPLOAD=true eas build --profile development --platform ios --local --non-interactive --output ./build/hevycoach-dev.ipa",
    "ios:install": "xcrun devicectl device install app --device \"$DEVICE_ID\" build/hevycoach-dev.ipa",
    "export:web": "expo export --platform web --output-dir .expo/web-export",
    "ios:build:preview": "SENTRY_DISABLE_AUTO_UPLOAD=true eas build --profile preview --platform ios --local --non-interactive --output ./build/hevycoach-preview.ipa",
    "ios:install:preview": "xcrun devicectl device install app --device \"$DEVICE_ID\" build/hevycoach-preview.ipa",
    "lint:functions": "deno lint --config supabase/functions/deno.json supabase/functions",
    "typecheck:functions": "deno check --config supabase/functions/coach/deno.json supabase/functions/coach/index.ts && deno check --config supabase/functions/webhook/deno.json supabase/functions/webhook/index.ts",
    "test:functions": "deno test --config supabase/functions/deno.json supabase/functions"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/supabase/"
    ]
  },
  "packageManager": "pnpm@11.5.0"
}
