{
  "name": "hevycoach-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.17",
    "@furkantanyol/hevy-client": "1.0.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/query-async-storage-persister": "^5.102.8",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-persist-client": "^5.102.8",
    "drizzle-orm": "^0.45.2",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-glass-effect": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@sentry/cli": "2.58.4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "~29.5.14",
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "validate": "pnpm lint && pnpm typecheck && pnpm test && pnpm export:web",
    "ios:device": "SENTRY_DISABLE_AUTO_UPLOAD=true expo run:ios --device",
    "ios:build": "SENTRY_DISABLE_AUTO_UPLOAD=true eas build --profile development --platform ios --local --non-interactive --output ./build/hevycoach-dev.ipa",
    "ios:install": "xcrun devicectl device install app --device \"$DEVICE_ID\" build/hevycoach-dev.ipa",
    "export:web": "expo export --platform web --output-dir .expo/web-export",
    "ios:build:preview": "SENTRY_DISABLE_AUTO_UPLOAD=true eas build --profile preview --platform ios --local --non-interactive --output ./build/hevycoach-preview.ipa",
    "ios:install:preview": "xcrun devicectl device install app --device \"$DEVICE_ID\" build/hevycoach-preview.ipa"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "testPathIgnorePatterns": [
          "<rootDir>/node_modules/",
          "<rootDir>/src/features/sync/.*\\.test\\.ts$"
        ]
      },
      {
        "displayName": "sync",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/src/features/sync/**/*.test.ts"
        ],
        "transform": {
          "^.+\\.[jt]sx?$": "babel-jest"
        },
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/src/$1"
        }
      }
    ]
  },
  "packageManager": "pnpm@11.5.0"
}
